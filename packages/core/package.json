{
  "name": "@npm-safe/core",
  "version": "1.0.5",
  "description": "Supply-chain security scanner for npm packages",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nisconder/npm-safe-forDSH.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nisconder/npm-safe-forDSH#readme",
  "bugs": {
    "url": "https://github.com/nisconder/npm-safe-forDSH/issues"
  }
}
