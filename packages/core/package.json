{
  "name": "@npm-safe/core-dsh",
  "version": "1.0.7",
  "description": "Thin DeepSeek Harness compatibility facade for the shared @npm-safe/core scanner",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "npm-security",
    "supply-chain-security",
    "dependency-security",
    "malware-detection",
    "static-analysis",
    "security-scanner"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@npm-safe/core": "1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nisconder/npm-safe-forDSH.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nisconder/npm-safe-forDSH#readme",
  "bugs": {
    "url": "https://github.com/nisconder/npm-safe-forDSH/issues"
  }
}
