{
  "name": "@npm-safe/core-dsh",
  "version": "1.0.6",
  "description": "Local-first npm supply-chain security engine with metadata and deep tarball scanning",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "keywords": [
    "npm-security",
    "supply-chain-security",
    "dependency-security",
    "malware-detection",
    "static-analysis",
    "security-scanner"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nisconder/npm-safe-forDSH.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nisconder/npm-safe-forDSH#readme",
  "bugs": {
    "url": "https://github.com/nisconder/npm-safe-forDSH/issues"
  }
}
